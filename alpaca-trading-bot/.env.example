# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Alpaca Paper Trading (default) ──────────────────────────────────────────
APCA_API_KEY_ID=your_paper_api_key_here
APCA_API_SECRET_KEY=your_paper_api_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ── To trade live (real money) change BASE_URL to: ──────────────────────────
# APCA_API_BASE_URL=https://api.alpaca.markets

# ── Strategy parameters ─────────────────────────────────────────────────────
STOCK_SYMBOL=AAPL
MA_SHORT=20
MA_LONG=50
RSI_PERIOD=14
ATR_PERIOD=14
ATR_SL_MULTIPLIER=2.0
ATR_TP_MULTIPLIER=3.0
TRADE_QUANTITY=1

# ── Risk management ─────────────────────────────────────────────────────────
SLIPPAGE=0.001
COMMISSION=0.0
MAX_TRADES_PER_DAY=5
DRAWDOWN_LIMIT=0.15
